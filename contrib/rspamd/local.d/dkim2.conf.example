# Copy to local.d/dkim2.conf and adjust only local paths and identity.
enabled = true;
endpoint = "http://127.0.0.1:8080/v1/process";
transport = "loopback";
capability_file = "/etc/dkim2/protected/process-capability";
timeout = 2.0;
max_response_bytes = 262144;
failure_mode = "tempfail";

# Retry-result storage is authoritative for one SMTP retry window. The binary
# HMAC key is independent from dkim2d replay material and contains 32-64 bytes.
retry_cache {
  secret_file = "/etc/dkim2/protected/rspamd-retry-hmac";
  # Rotate this opaque value whenever the dkim2d build/schema, local policy,
  # replay authority/namespace, endpoint tenant, or capability generation changes.
  authority_generation = "verifier-policy-replay-2026-08-31";
  ttl_ms = 86400000;
  lease_ms = 30000;
  redis {
    servers = "127.0.0.1:6379";
    # Put ACL credentials only in a separately protected site include. Never
    # ship them in this example, an image, or an environment variable.
  }
}

# Nauthilus is called only through the existing generic Policy endpoint. The
# password file contains the exact Policy-Basic password without a newline.
# Rspamd's global ssl_ca_path must trust the Policy endpoint certificate.
nauthilus {
  endpoint = "https://nauthilus-policy:9443/api/v1/policy/decisions";
  server_name = "nauthilus-policy";
  username = "rspamd-verifier";
  password_file = "/etc/dkim2/protected/nauthilus-policy-password";
  instance = "mx01.example.test";
  timeout = 2.0;
  max_response_bytes = 65536;

  # These listener-scoped privacy classes are policy inputs, not substitutes
  # for the mandatory exact SMTP peer IP. Null MAIL FROM is detected per task.
  client_class = "untrusted";
  mail_from_class = "external";
  recipient_classes = ["local"];

  # Optional, default false. When exactly true, the received delivery-status
  # propagation class is sent as the dkim2.received_dsn_propagation resource
  # attribute. Enable it only after the Nauthilus policy admits that attribute
  # in allowed_resource_attributes with a string schema whose max_length is at
  # least 30. Against a closed allowlist that has not admitted it, Nauthilus
  # answers 403 and every received notification is tempfailed as
  # DKIM2_NAUTHILUS_INDETERMINATE.
  # received_dsn_attribute = false;
}

# Optional. Administrative tenant for received delivery-status locality. It is
# sent as the request context tenant and is an authority key only, never an
# identity claim. Without it the daemon falls back to its own configured
# default tenant, and the received delivery-status projection reports
# local_hop = not_evaluated and propagation = not_evaluated.
# tenant = "tenant-a";

# Optional. When set, dkim2d owns the exact Authentication-Results value.
# Existing Authentication-Results fields are removed before that value is
# inserted so forged local authority cannot survive the trust boundary.
# authserv_id = "mx.example.test";

# Private-service-network alternative. Rspamd's global ssl_ca_path must trust
# the internal PKI that issued the dkim2d-inbound certificate.
# endpoint = "https://dkim2d-inbound:8443/v1/process";
# transport = "tls_private_network";
# server_name = "dkim2d-inbound";

# Optional independent learning. Enable only with the matching Nauthilus source
# admission and real reputation/GeoIP providers. This principal is distinct from
# rspamd-verifier. Omission disables new observations; it does not drain a queue.
