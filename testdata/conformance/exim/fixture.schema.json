{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/dkim2/conformance/exim/fixture.schema.json",
  "$defs": {
    "b64": {"maxLength": 22369624, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$", "type": "string"}
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {"maxLength": 128, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "type": "string"},
    "class": {"const": "adapter_contract"},
    "dns_draft": {"const": "draft-chuang-dkim2-dns-04"},
    "evidence_state": {"const": "deferred"},
    "expected": {
      "additionalProperties": false,
      "properties": {
        "exim_outcome": {"enum": ["accept", "reject", "tempfail"]},
        "fidelity": {"enum": ["exim_local_scan", "exim_transport_filter"]},
        "operation": {"enum": ["process", "sign", "revise"]}
      },
      "required": ["exim_outcome", "operation", "fidelity"],
      "type": "object"
    },
    "message_b64": {"$ref": "#/$defs/b64"},
    "message_draft": {"const": "draft-ietf-dkim-dkim2-spec-04"},
    "operation": {"enum": ["process", "sign", "revise"]},
    "path": {"enum": ["local_scan", "transport_filter"]},
    "schema": {"const": "dkim2.exim-adapter-fixture.v1"},
    "smtp": {
      "additionalProperties": false,
      "properties": {
        "forward_paths_b64": {"items": {"$ref": "#/$defs/b64"}, "maxItems": 1024, "type": "array"},
        "reverse_path_b64": {"$ref": "#/$defs/b64"}
      },
      "required": ["reverse_path_b64", "forward_paths_b64"],
      "type": "object"
    }
  },
  "required": ["schema", "case_id", "message_draft", "dns_draft", "class", "path", "operation", "message_b64", "smtp", "expected", "evidence_state"],
  "type": "object"
}
