{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/dkim2/interop/discovery-evidence.schema.json",
  "$defs": {
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "source": {
      "additionalProperties": false,
      "properties": {
        "id": {"pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string"},
        "state": {"enum": ["observed", "not_found", "unavailable", "invalid"], "type": "string"},
        "response_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["id", "state"],
      "type": "object"
    },
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "id": {"pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string"},
        "canonical_location": {"format": "uri", "maxLength": 512, "type": "string"},
        "revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "tree_sha": {"pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$", "type": "string"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "build_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_sha256": {"$ref": "#/$defs/sha256"},
        "license": {"maxLength": 64, "pattern": "^[A-Za-z0-9.+-]+$", "type": "string"},
        "claimed_draft": {"maxLength": 96, "type": "string"},
        "operations": {
          "items": {"pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string"},
          "maxItems": 32,
          "type": "array"
        },
        "state": {
          "enum": [
            "eligible_runnable",
            "eligible_vectors_only",
            "ineligible_not_dkim2",
            "ineligible_not_independent",
            "ineligible_no_immutable_source",
            "ineligible_license_unknown",
            "ineligible_unsafe_execution",
            "ineligible_no_overlap",
            "source_unavailable",
            "malformed_evidence"
          ],
          "type": "string"
        },
        "reason": {"pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string"},
        "evidence_sources": {
          "items": {"pattern": "^[a-z][a-z0-9-]{0,63}$", "type": "string"},
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": ["id", "canonical_location", "operations", "state", "reason", "evidence_sources"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "dkim2.interop-discovery-evidence.v1"},
    "message_draft": {"const": "draft-ietf-dkim-dkim2-spec-04"},
    "dns_draft": {"const": "draft-chuang-dkim2-dns-04"},
    "base_revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "candidate_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "observation_cutoff": {"format": "date-time", "type": "string"},
    "sources": {"items": {"$ref": "#/$defs/source"}, "maxItems": 64, "minItems": 5, "type": "array"},
    "candidates": {"items": {"$ref": "#/$defs/candidate"}, "maxItems": 64, "type": "array"},
    "availability": {
      "enum": [
        "compared",
        "no_eligible_candidate",
        "eligible_not_runnable",
        "disagreement",
        "discovery_unavailable",
        "evidence_invalid"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema",
    "message_draft",
    "dns_draft",
    "base_revision",
    "candidate_snapshot_sha256",
    "registry_sha256",
    "observation_cutoff",
    "sources",
    "candidates",
    "availability"
  ],
  "type": "object"
}
