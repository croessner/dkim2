{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/dkim2/security/report.schema.json",
  "$defs": {
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {"maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string"},
        "path": {"enum": [".artifacts/conformance-full/report.json", ".artifacts/conformance-portable/report.json", ".artifacts/conformance-postfix/run-1/report.json", ".artifacts/conformance-postfix/run-2/report.json", ".artifacts/security/fuzz.json", ".artifacts/security/race.json", ".artifacts/security/vulnerability.json"]},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["id", "path", "sha256"],
      "type": "object"
    },
    "findings": {
      "additionalProperties": false,
      "properties": {
        "critical": {"const": 0},
        "high": {"const": 0},
        "low": {"const": 0},
        "medium": {"const": 0}
      },
      "required": ["critical", "high", "medium", "low"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_revision": {"const": "b3979123febbc333fb8ed85c8c1801ba5caf5def"},
    "candidate_snapshot_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "dns_draft": {"const": "draft-chuang-dkim2-dns-04"},
    "evidence": {"items": {"$ref": "#/$defs/evidence"}, "maxItems": 7, "minItems": 7, "type": "array"},
    "exim": {"const": "qualified_linux"},
    "fuzz_state": {"const": "pass"},
    "fuzz_targets": {"maximum": 4096, "minimum": 1, "type": "integer"},
    "go_version": {"pattern": "^go1\\.26\\.[0-9]+$", "type": "string"},
    "goarch": {"maxLength": 32, "pattern": "^[a-z0-9]+$", "type": "string"},
    "goos": {"maxLength": 32, "pattern": "^[a-z0-9]+$", "type": "string"},
    "inventory_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "message_draft": {"const": "draft-ietf-dkim-dkim2-spec-04"},
    "overall": {"const": "pass"},
    "profile": {"const": "complete"},
    "race": {"const": "required_pass"},
    "schema": {"const": "dkim2.security-report.v1"},
    "unresolved_findings": {"$ref": "#/$defs/findings"},
    "vulnerability_state": {"const": "pass"}
  },
  "required": ["schema", "message_draft", "dns_draft", "base_revision", "candidate_snapshot_sha256", "profile", "inventory_sha256", "go_version", "goos", "goarch", "race", "fuzz_targets", "fuzz_state", "vulnerability_state", "evidence", "unresolved_findings", "exim", "overall"],
  "type": "object"
}
