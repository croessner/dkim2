-- Replace the database and complete quoted account placeholders before use.
-- Accounts are site-owned, TLS-required, and created outside this file.
-- The publisher and three v3 accounts must be distinct. No account receives DELETE, DDL,
-- FILE, global, credential-management, or role-administration authority.

GRANT SELECT ON __DATABASE__.dkim2_dataset_generations TO __RUNTIME_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_current_generation TO __RUNTIME_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_handles TO __RUNTIME_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_profiles TO __RUNTIME_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_credentials TO __RUNTIME_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_policies TO __RUNTIME_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_key_material TO __RUNTIME_ACCOUNT__;

-- The compatibility publisher retains v2-only publication through fixed
-- definer procedures. Its sole direct mutation privilege is UPDATE(singleton)
-- for the v2 locking read; it has no v3 procedure or v3 lock-metadata update.
GRANT SELECT ON __DATABASE__.dkim2_publication_lock TO __PUBLISHER_ACCOUNT__;
GRANT UPDATE (singleton) ON __DATABASE__.dkim2_publication_lock TO __PUBLISHER_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_dataset_generations TO __PUBLISHER_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_current_generation TO __PUBLISHER_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_handles TO __PUBLISHER_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_profiles TO __PUBLISHER_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_credentials TO __PUBLISHER_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_policies TO __PUBLISHER_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_key_material TO __PUBLISHER_ACCOUNT__;
GRANT EXECUTE ON PROCEDURE __DATABASE__.dkim2_v2_insert_generation TO __PUBLISHER_ACCOUNT__;
GRANT EXECUTE ON PROCEDURE __DATABASE__.dkim2_v2_insert_handle TO __PUBLISHER_ACCOUNT__;
GRANT EXECUTE ON PROCEDURE __DATABASE__.dkim2_v2_insert_profile TO __PUBLISHER_ACCOUNT__;
GRANT EXECUTE ON PROCEDURE __DATABASE__.dkim2_v2_insert_credential TO __PUBLISHER_ACCOUNT__;
GRANT EXECUTE ON PROCEDURE __DATABASE__.dkim2_v2_insert_policy TO __PUBLISHER_ACCOUNT__;
GRANT EXECUTE ON PROCEDURE __DATABASE__.dkim2_v2_insert_key_material TO __PUBLISHER_ACCOUNT__;
GRANT EXECUTE ON PROCEDURE __DATABASE__.dkim2_v2_seal_generation TO __PUBLISHER_ACCOUNT__;
GRANT EXECUTE ON PROCEDURE __DATABASE__.dkim2_v2_insert_current TO __PUBLISHER_ACCOUNT__;
GRANT EXECUTE ON PROCEDURE __DATABASE__.dkim2_v2_update_current TO __PUBLISHER_ACCOUNT__;

GRANT EXECUTE ON PROCEDURE __DATABASE__.dkim2_v3_lock_observe TO __SNAPSHOT_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_dataset_generations TO __SNAPSHOT_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_current_generation TO __SNAPSHOT_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_handles TO __SNAPSHOT_ACCOUNT__;
GRANT SELECT ON __DATABASE__.dkim2_profiles TO __SNAPSHOT_ACCOUNT__;
