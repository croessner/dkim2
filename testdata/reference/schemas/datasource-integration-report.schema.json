{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkim2.invalid/schemas/datasource-integration-report.schema.json",
  "title": "DKIM2 datasource integration report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "base_revision", "candidate_snapshot_sha256", "ldap_image",
    "postgresql_image", "mysql_image", "mariadb_image",
    "runtime_qualification_runs", "checks", "results", "overall"
  ],
  "properties": {
    "schema": {"const": "dkim2.datasource-integration-report.v2"},
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ldap_image": {"const": "chrroessner/openldap:2.6.13-r4@sha256:17f2e3485dae92122051da6acdb1091e6d9f1f64d30fd76fd3da3c261c6c778f"},
    "postgresql_image": {"const": "postgres:18.3-alpine@sha256:54451ecb8ab38c24c3ec123f2fd501303a3a1856a5c66e98cecf2460d5e1e9d7"},
    "mysql_image": {"const": "mysql:8.4@sha256:b3b90af2a6552ae30c266fdb7d5dd55f3afb72404bb78d37fe8a23eb857fd3fb"},
    "mariadb_image": {"const": "mariadb:10.11@sha256:be981e4113326ada8d6004174dd09eeaefc03094037f811182a52d4f2e737350"},
    "runtime_qualification_runs": {"const": 4},
    "checks": {
      "type": "array",
      "minItems": 54,
      "maxItems": 54,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ldap_parity_and_denials",
          "postgresql_parity_and_denials",
          "mysql_parity_and_denials",
          "mariadb_parity_and_denials",
          "ldap_absent_to_first_concurrency_fence",
          "postgresql_absent_to_first_concurrency_fence",
          "ldap_pointerless_nonempty_denial",
          "postgresql_pointerless_nonempty_denial",
          "mysql_absent_to_first_concurrency_fence",
          "mariadb_absent_to_first_concurrency_fence",
          "mysql_pointerless_nonempty_denial",
          "mariadb_pointerless_nonempty_denial",
          "postgresql_v2_to_v3_upgrade_and_two_rotations",
          "mysql_v2_to_v3_upgrade_and_two_rotations",
          "mariadb_v2_to_v3_upgrade_and_two_rotations",
          "postgresql_v3_observed_lock_contention_activation_race",
          "mysql_v3_observed_lock_contention_activation_race",
          "mariadb_v3_observed_lock_contention_activation_race",
          "postgresql_fresh_v3_bootstrap_and_rotation",
