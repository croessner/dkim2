{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/dkim2/conformance/exim/result.schema.json",
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "name": {"maxLength": 64, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "type": "string"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["name", "sha256"],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {"items": {"$ref": "#/$defs/artifact"}, "maxItems": 128, "minItems": 1, "type": "array"},
        "case_ended": {"format": "date-time", "type": "string"},
        "case_started": {"format": "date-time", "type": "string"},
        "identity": {
          "additionalProperties": false,
          "properties": {
            "authentication_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "build_id": {"maxLength": 256, "minLength": 1, "type": "string"},
            "distribution_package": {"maxLength": 256, "minLength": 1, "type": "string"},
            "module_abi": {"maxLength": 256, "minLength": 1, "type": "string"},
            "platform": {"maxLength": 128, "minLength": 1, "type": "string"},
            "upstream_version": {"maxLength": 64, "minLength": 1, "type": "string"}
          },
          "required": ["upstream_version", "distribution_package", "authentication_sha256", "build_id", "module_abi", "platform"],
          "type": "object"
        },
        "producer_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "relations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["input_to_daemon", "daemon_to_adapter", "adapter_to_output", "smtp_to_output"]},
              "left_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
              "right_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
            },
            "required": ["kind", "left_sha256", "right_sha256"],
            "type": "object"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "transcripts": {"items": {"$ref": "#/$defs/artifact"}, "maxItems": 32, "minItems": 1, "type": "array"}
      },
      "required": ["identity", "producer_sha256", "case_started", "case_ended", "artifacts", "transcripts", "relations"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "evidence": {"additionalProperties": false, "maxProperties": 0, "type": "object"},
        "state": {"const": "deferred"}
      }
    },
    {
      "properties": {
        "evidence": {"$ref": "#/$defs/evidence"},
        "state": {"enum": ["pass", "fail"]}
      }
    }
  ],
  "properties": {
    "case_id": {"maxLength": 128, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "type": "string"},
    "evidence": {
      "oneOf": [
        {"additionalProperties": false, "maxProperties": 0, "type": "object"},
        {"$ref": "#/$defs/evidence"}
      ]
    },
    "schema": {"const": "dkim2.exim-adapter-result.v1"},
    "state": {"enum": ["deferred", "pass", "fail"]}
  },
  "required": ["schema", "case_id", "state", "evidence"],
  "type": "object"
}
