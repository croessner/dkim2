{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/dkim2/conformance/manifest.schema.json",
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "id": {"maxLength": 128, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "type": "string"},
        "module": {"enum": ["lib", "cmd/dkim2d", "cmd/dkim2ctl", "cmd/dkim2-milter", "cmd/dkim2-exim", "testdata/conformance", "contrib/qualification/postfix-milter", "scripts", "tools"]},
        "path": {"maxLength": 4096, "minLength": 1, "type": "string"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["id", "path", "sha256", "module"],
      "type": "object"
    },
    "case": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {"items": {"maxLength": 128, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "type": "string"}, "maxItems": 32, "minItems": 1, "type": "array"},
        "authority": {"items": {"maxLength": 160, "minLength": 1, "pattern": "^[^\\r\\n\u0000]+$", "type": "string"}, "maxItems": 16, "minItems": 1, "type": "array"},
        "case_id": {"maxLength": 128, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "type": "string"},
        "class": {"enum": ["draft_normative", "rfc_normative", "documented_interpretation", "local_security_policy", "openapi_contract", "adapter_contract"]},
        "expected_outcome": {"const": "pass"},
        "producer": {"maxLength": 64, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "type": "string"},
        "provenance": {"enum": ["draft_example", "rfc_example", "independent_oracle", "cross_primitive", "manual_derivation", "regression_reproducer"]},
        "required_platform": {"enum": ["portable", "linux"]},
        "runner": {"enum": ["portable_vector", "openapi_fixture", "milter_fixture", "postfix_qualification"]},
        "suite": {"maxLength": 128, "not": {"const": "exim"}, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "type": "string"}
      },
      "required": ["suite", "case_id", "class", "authority", "provenance", "runner", "required_platform", "expected_outcome", "artifacts", "producer"],
      "type": "object"
    },
    "capabilities": {
      "additionalProperties": false,
      "properties": {
        "daemon": {"const": "supported"},
        "exim": {"const": "unqualified_draft05"},
        "library": {"const": "supported"},
        "milter": {"const": "partial"},
        "postfix": {"const": "partial_linux"}
      },
      "required": ["library", "daemon", "milter", "postfix", "exim"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {"items": {"$ref": "#/$defs/artifact"}, "maxItems": 4096, "minItems": 1, "type": "array"},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "cases": {"items": {"$ref": "#/$defs/case"}, "maxItems": 16384, "minItems": 1, "type": "array"},
    "dns_draft": {"const": "draft-chuang-dkim2-dns-04"},
    "message_draft": {"const": "draft-ietf-dkim-dkim2-spec-05"},
    "schema": {"const": "dkim2.conformance-manifest.v1"},
    "suite_version": {"const": "1"},
    "suites": {"items": {"maxLength": 128, "not": {"const": "exim"}, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "type": "string"}, "maxItems": 4096, "minItems": 1, "type": "array"}
  },
  "required": ["schema", "message_draft", "dns_draft", "suite_version", "suites", "capabilities", "artifacts", "cases"],
  "type": "object"
}
